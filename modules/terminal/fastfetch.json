{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "padding": {
      "right": 4
    },
    "color": {
      "1": "red"
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#ff4fd8",
      "output": "#f8e7ff",
      "separator": "#a970ff"
    },
    "showErrors": false,
    "key": {
      "width": 12
    }
  },
  "modules": [
    {
      "type": "custom",
      "key": " ",
      "format": "BUBBLE GUM RAVE / DECK",
      "outputColor": "#ff4fd8"
    },
    {
      "type": "os",
      "key": "OS"
    },
    {
      "type": "host",
      "key": "Model"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "HARDWARE / RESOURCES",
      "outputColor": "#42f5ff"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{name} / {cores-physical}C {cores-logical}T"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{name} / {driver}"
    },
    {
      "type": "memory",
      "key": "RAM"
    },
    {
      "type": "swap",
      "key": "Swap"
    },
    {
      "type": "battery",
      "key": "Battery"
    },
    "break",
    {
      "type": "custom",
      "key": " ",
      "format": "STORAGE / SESSION",
      "outputColor": "#a970ff"
    },
    {
      "type": "disk",
      "key": "Home",
      "format": "{size-available} free / {size-total}",
      "folders": "/home"
    },
    {
      "type": "disk",
      "key": "Drive ({mountpoint})",
      "showRegular": false,
      "showExternal": true,
      "format": "{size-available} free / {size-total}"
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "de",
      "key": "Desktop"
    },
    {
      "type": "wm",
      "key": "Session"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "shell",
      "key": "Shell"
    }
  ]
}
